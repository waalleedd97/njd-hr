# ==========================================================================
# NJD HR — Environment Variables
# Copy this file to `.env.local` (for dev) and populate Vercel / Supabase
# equivalents for production deployments.
# ==========================================================================

# ───── Supabase (required) ─────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API
# The anon key is safe for client bundles; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://iauulqfgrbegwcnfatmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Dvk_dI_FY6oxhyOw7__06Q_wzDmwguJ

# Server-side only. Allows /api/notifications/admins and /api/notifications/user
# to bypass RLS for cross-user notification inserts. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ───── Email (required if you send invitations) ───────────────────────────
# From https://resend.com/api-keys
RESEND_API_KEY=
# Defaults to "NJD Games HR <onboarding@resend.dev>" which only works for
# verified emails. Use a domain-verified sender in production.
RESEND_FROM_EMAIL=

# ───── App URL (used in invitation emails) ─────────────────────────────────
# Used as the login link target in the invitation email template.
NEXT_PUBLIC_APP_URL=https://hr.njd-services.net

# ───── Push Notifications (optional) ───────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Only the PUBLIC key goes here; keep the private key server-side in an
# Edge Function that signs push payloads.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ───── Observability — Sentry (optional) ───────────────────────────────────
# From sentry.io → Settings → Projects → YOUR_PROJECT → Client Keys (DSN)
# When unset, the built-in observability layer is a no-op.
NEXT_PUBLIC_SENTRY_DSN=

# ───── Release tagging (optional) ─────────────────────────────────────────
# Helps correlate errors with specific deployments.
# In Vercel, bind this to $VERCEL_GIT_COMMIT_SHA automatically.
NEXT_PUBLIC_APP_VERSION=
